# Minimal BMAD project config emitted by wf scaffold so the planning skills
# resolve to THIS project (not the installed bmad repo). A later
# `npx bmad-method install` regenerates these and preserves _bmad/custom/.
user_name: {{USER_NAME}}
project_name: {{PROJECT_NAME}}
communication_language: English
document_output_language: English
output_folder: _bmad-output
planning_artifacts: "{project-root}/_bmad-output/planning-artifacts"
implementation_artifacts: "{project-root}/_bmad-output/implementation-artifacts"
project_knowledge: "{project-root}/docs"
user_skill_level: intermediate
